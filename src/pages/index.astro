---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const posts = await getCollection('blog');
const sortedPosts = posts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout title="Home | Studio Blog">
  <div class="space-y-8">
    <header class="space-y-2 border-b border-zinc-800 pb-6">
      <h1 class="text-4xl font-extrabold tracking-tight">Recent Compositions & Entries</h1>
      <p class="text-zinc-400">Audio releases, sheet music notes, and studio photography.</p>
    </header>

    <div class="grid gap-6">
      {sortedPosts.map((post) => {
        // Astro Content Collections v5+ use post.id, older versions use post.slug
        const slug = post.slug || post.id.replace(/\.(md|mdx)$/, '');
        
        return (
          <a
            href={`/blog/${slug}`}
            class="block p-6 rounded-2xl bg-zinc-900/60 border border-zinc-800/80 hover:border-zinc-700 hover:bg-zinc-900 transition group"
          >
            <div class="flex justify-between items-start mb-2">
              <h2 class="text-2xl font-semibold text-zinc-100 group-hover:text-emerald-400 transition">
                {post.data.title}
              </h2>
              <time class="text-xs text-zinc-500 font-mono">
                {post.data.pubDate.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}
              </time>
            </div>
            <p class="text-zinc-400 text-sm line-clamp-2">{post.data.description}</p>
          </a>
        );
      })}
    </div>
  </div>
</BaseLayout>