---
import { ClientRouter } from 'astro:transitions';
import SpotifyPlayer from '../components/SpotifyPlayer';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const { title = "Astro Music & Photo Blog", description = "Personal blog with audio, sheet music, and photos." } = Astro.props;
---

<!usr/bin/env html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <ClientRouter />
  </head>
  <body class="bg-zinc-950 text-zinc-100 min-h-screen pb-32">
    <header class="border-b border-zinc-800/80 bg-zinc-950/80 backdrop-blur-md sticky top-0 z-40">
      <div class="max-w-4xl mx-auto px-4 h-16 flex items-center justify-between">
        <a href="/" class="text-xl font-bold tracking-tight text-white hover:text-emerald-400 transition">
          🎵 Studio Blog
        </a>
      </div>
    </header>

    <main class="max-w-4xl mx-auto px-4 py-10">
      <slot />
    </main>

    <SpotifyPlayer client:load transition:persist />
  </body>
</html>